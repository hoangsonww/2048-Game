# 2048 Cloud API — environment
#
# Copy to `.env` for local development. `.env` is gitignored; never commit a
# real connection string or secret. On Vercel these are project environment
# variables, set with `vercel env add`.

# --- Required -------------------------------------------------------------

# MongoDB connection string. The database name below overrides any path in it,
# so one cluster can host this alongside unrelated applications.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=game2048

# Signing secrets. Generate with: openssl rand -hex 32
# Outside production a random secret is invented at boot, which is convenient
# locally and would invalidate every token on each deploy in production — so
# production refuses to start without these.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Optional -------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Absolute URL this deployment is reachable at. Used for the `servers` block in
# the OpenAPI document when the request carries no forwarding headers.
PUBLIC_URL=http://localhost:4000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=https://hoangsonww.github.io,https://the-2048.netlify.app,http://localhost:8080
CORS_ALLOW_ALL=false

JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=5184000
BCRYPT_ROUNDS=11
MAX_SESSIONS_PER_USER=20

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=240
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=90

MAX_SAVE_SLOTS=10
PAGE_SIZE_DEFAULT=25
PAGE_SIZE_MAX=100

# Feature flags. Turning one off makes its whole router answer 503 with
# `feature_disabled`, which is how a surface is retired without a redeploy of
# every client.
FEATURE_REGISTRATION=true
FEATURE_LEADERBOARDS=true
FEATURE_CLOUD_SAVES=true
FEATURE_SOCIAL=true
FEATURE_DAILY_CHALLENGE=true
FEATURE_EVENTS=true

# --- Integration tests ----------------------------------------------------
# Tests refuse to run against a database whose name does not end in `_test`.
MONGODB_TEST_URI=
MONGODB_TEST_DB=game2048_test
